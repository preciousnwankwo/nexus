// Nexus example with print and loops
fn fibonacci(n: i32) -> i32 {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn main() {
    println("Fibonacci sequence:")
    for i in 10 {
        let result = fibonacci(i)
        println(result)
    }

    let sum = 0
    let n = 1
    while n <= 10 {
        sum = sum + n
        n = n + 1
    }
    println("Sum = ")
    println(sum)
}
